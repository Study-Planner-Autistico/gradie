{
  "expo": {
    "name": "Gradie",
    "slug": "gradie",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.gradie.student"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6D5BF0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Il microfono serve per registrare note audio nella lavagna."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Il calendario serve per importare in Agenda gli eventi dei calendari che scegli."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID serve per sbloccare l'app se attivi lo sblocco nelle Impostazioni."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Le foto servono per aggiungere immagini alla lavagna."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F4F2FF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#18191A"
          }
        }
      ]
    ],
    "scheme": "gradie"
  }
}
